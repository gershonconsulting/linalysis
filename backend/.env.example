# Linalysis backend environment — copy to .env and fill in values
# NEVER commit the real .env to git.

APP_ENV=production
APP_NAME=Linalysis
APP_URL=https://api.linalysis.net
APP_CORS_ORIGINS=https://linalysis.net,https://www.linalysis.net,https://linalysis.pages.dev

# MySQL (Hostinger → hPanel → Databases → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_linalysis
DB_USER=u000000000_linalysis
DB_PASS=

# JWT secret for API tokens used by the Chrome extension.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Session cookie (used by the browser dashboard).
SESSION_COOKIE_NAME=linalysis_session
SESSION_COOKIE_DOMAIN=.linalysis.net
SESSION_TTL_DAYS=30

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_
STRIPE_PUBLISHABLE_KEY=pk_live_
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_

# SMTP (Hostinger → Emails → Email accounts → support@linalysis.net)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=support@linalysis.net
SMTP_PASS=
SMTP_FROM_EMAIL=support@linalysis.net
SMTP_FROM_NAME=Linalysis

# CookieVerify (for li_at validation — already in use on troubleshooting page)
COOKIEVERIFY_API=https://api.cookieverify.com

# Rate limits
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_INGEST_PER_HOUR=100
