# Cloudflare Pages _headers — force text/html on clean (extensionless) paths
# so browsers render them as pages instead of downloading.

/login
  Content-Type: text/html; charset=utf-8
/signup
  Content-Type: text/html; charset=utf-8
/dashboard
  Content-Type: text/html; charset=utf-8
/summary
  Content-Type: text/html; charset=utf-8
/company
  Content-Type: text/html; charset=utf-8
/campaigns
  Content-Type: text/html; charset=utf-8
/my-data
  Content-Type: text/html; charset=utf-8
/account
  Content-Type: text/html; charset=utf-8
/pricing
  Content-Type: text/html; charset=utf-8
/reports
  Content-Type: text/html; charset=utf-8
/troubleshooting
  Content-Type: text/html; charset=utf-8
/my-ssi
  Content-Type: text/html; charset=utf-8

# Extension downloads must never be cached — always serve the freshest build.
/linalysis-extension.zip
  Cache-Control: no-store, max-age=0
/linalysis-extension-*.zip
  Cache-Control: no-store, max-age=0
/extension/updates.xml
  Cache-Control: no-store, max-age=0
/extension/linalysis.crx
  Cache-Control: no-store, max-age=0
/messaging
  Content-Type: text/html; charset=utf-8
/emailing
  Content-Type: text/html; charset=utf-8
/import-export
  Content-Type: text/html; charset=utf-8
/guests
  Content-Type: text/html; charset=utf-8
/terms
  Content-Type: text/html; charset=utf-8
/privacy
  Content-Type: text/html; charset=utf-8
/cookies
  Content-Type: text/html; charset=utf-8
/forgot-password
  Content-Type: text/html; charset=utf-8

# Core app scripts/styles are NOT content-hashed, so long edge caching served stale
# code after deploys (a recurring "my deploy isn't showing" problem). Force revalidation
# so every deploy propagates immediately; unchanged files still return a cheap 304.
/nav.js
  Cache-Control: no-cache
/stats-helpers.js
  Cache-Control: no-cache
/live-data.js
  Cache-Control: no-cache
/api.js
  Cache-Control: no-cache
/data.js
  Cache-Control: no-cache
/ai-insights.js
  Cache-Control: no-cache
/plan.js
  Cache-Control: no-cache
/first-time-guard.js
  Cache-Control: no-cache
/onboarding.js
  Cache-Control: no-cache
/common.css
  Cache-Control: no-cache
